# EFJ - Kết nối cộng đồng: biến môi trường
# Trên Hostinger: hPanel → Websites → partner.efj-group.com → Node.js → Environment variables.
# Khi chạy trên máy: copy file này thành .env rồi điền giá trị. KHÔNG commit file .env.

NODE_ENV=production
# Hostinger tự cấp PORT, không cần đặt. Trên máy dùng 3000.
# PORT=3000

# Địa chỉ public, dùng để tạo link trong mã QR (không có dấu / ở cuối)
PUBLIC_URL=https://partner.efj-group.com

# MySQL (hPanel → Databases → MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Mật khẩu đăng nhập quản trị dashboard (ít nhất 10 ký tự)
ADMIN_PASSWORD=

# Chuỗi bí mật ngẫu nhiên, ít nhất 32 ký tự. Tạo bằng: openssl rand -hex 32
SESSION_SECRET=
# Dùng để sinh mã truy cập của 75 quán. ĐỔI chuỗi này = mọi mã quán đều đổi.
SHOP_CODE_SECRET=

# Google Sheets (xem docs/GOOGLE-SHEETS.md). Để trống nếu chưa dùng.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_TOKEN=

# Google Analytics 4, dạng G-XXXXXXXXXX. Để trống để tắt.
GA_MEASUREMENT_ID=

# Link Eco-Life cho ưu đãi nội thất (mã quán được gắn thêm ?ref=TK01)
ECOLIFE_URL=https://ecolife123.com/
